# HIRICA Environment Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN SENSITIVE VALUES
# DO NOT COMMIT .env.local OR PRIVATE KEYS TO VERSION CONTROL

# Groq High-Speed LLM API (Required for Multi-Agent & Dynamic Assessments)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Inference API Key (Optional)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Firebase Web Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend Service Account (Relative or absolute path to JSON key)
FIREBASE_CREDENTIALS_PATH=./Backend/firebase-credentials.json

# API Server URL
VITE_API_URL=http://localhost:8000
